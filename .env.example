# Supabase project settings > API. The service role key, not the anon key —
# the browser never talks to Supabase directly.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Console. Two separate keys on purpose — see README.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# npm run hash -- "the viewer password"
# (prints base64, not a raw bcrypt hash -- see src/lib/auth.ts for why)
VIEWER_PASSWORD_HASH=
# npm run hash -- "the editor password"
EDITOR_PASSWORD_HASH=
